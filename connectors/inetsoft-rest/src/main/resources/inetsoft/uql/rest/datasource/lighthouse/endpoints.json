{
  "endpoints": [
    {
      "name": "Changesets",
      "paged": false,
      "suffix": "/projects/{Project ID}/changesets.json",
      "description": "The source-control commits linked to one project, with the revision, author, message and the tickets each references. Requires a project id. The bridge between issues and code, where a repository is connected.",
      "responseSchema": {
        "changesets": [
          {
            "changeset": {
              "body": "string",
              "body_html": "string",
              "changed_at": "timeInstant",
              "committer": "string",
              "project_id": "double",
              "revision": "string",
              "ticket_id": "double",
              "title": "string",
              "user_id": "double"
            }
          }
        ]
      }
    },
    {
      "name": "Changeset",
      "paged": false,
      "suffix": "/projects/{Project ID}/changesets/{Revision Name}.json",
      "description": "One changeset by revision. Requires the project id.",
      "responseSchema": {
        "changeset": {
          "body": "string",
          "body_html": "string",
          "changed_at": "timeInstant",
          "committer": "string",
          "project_id": "double",
          "revision": "string",
          "ticket_id": "double",
          "title": "string",
          "user_id": "double"
        }
      }
    },
    {
      "name": "Projects",
      "paged": false,
      "suffix": "/projects.json",
      "lookups": [
        {
          "endpoints": [
            "Changesets",
            "Tickets",
            "Ticket Bins",
            "Milestones",
            "Messages",
            "Project Memberships"
          ],
          "jsonPath": "$.projects[*].project",
          "key": "id",
          "parameterName": "Project ID"
        }
      ],
      "description": "The projects in the account, each with name, description, open and closed ticket counts, and its default assignee and milestone. The container everything else belongs to; every other endpoint needs a project id.",
      "responseSchema": {
        "projects": [
          {
            "project": {
              "archived": "boolean",
              "closed_states": "string",
              "created_at": "timeInstant",
              "default_assigned_user_id": "double",
              "default_milestone_id": "double",
              "default_ticket_text": "string",
              "description": "string",
              "description_html": "string",
              "enable_points": "boolean",
              "hidden": "boolean",
              "id": "double",
              "license": "string",
              "name": "string",
              "open_states": "string",
              "open_tickets_count": "double",
              "oss_readonly": "boolean",
              "permalink": "string",
              "points_scale": "string",
              "public": "boolean",
              "send_changesets_to_events": "boolean",
              "todos_completed": {
                "projects": "boolean",
                "tickets": "boolean",
                "milestones": "boolean"
              },
              "updated_at": "timeInstant"
            }
          }
        ]
      }
    },
