          "page": "double",
          "pages": "double",
          "count": "double",
          "items": [
            {
              "id": "string",
              "siteId": "string",
              "number": "double",
              "slug": "string",
              "visibility": "string",
              "order": "double",
              "name": "string",
              "description": "string",
