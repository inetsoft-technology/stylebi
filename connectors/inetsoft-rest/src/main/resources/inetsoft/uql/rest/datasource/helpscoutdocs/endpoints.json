{
  "endpoints": [
    {
      "name": "Collection Articles",
      "paged": true,
      "suffix": "/v1/collections/{Collection ID}/articles?status={Status?:all|published|notpublished}",
      "responseSchema": {
        "articles": {
          "page": "double",
          "pages": "double",
          "count": "double",
          "items": [
            {
              "id": "string",
              "number": "double",
              "collectionId": "string",
              "slug": "string",
              "status": "string",
              "hasDraft": "boolean",
              "name": "string",
              "publicUrl": "string",
              "popularity": "double",
              "viewCount": "double",
              "createdBy": "double",
              "updatedBy": "double",
              "createdAt": "timeInstant",
              "updatedAt": "timeInstant",
              "lastPublishedAt": "timeInstant"
            }
          ]
        }
      },
      "lookups": [
        {
          "endpoint": "Article",
          "jsonPath": "$.articles.items[*]",
          "key": "id",
          "parameterName": "Article ID or Number"
        },
        {
          "endpoints": [
            "Related Articles",
            "Revisions"
          ],
          "jsonPath": "$.articles.items[*]",
          "key": "id",
          "parameterName": "Article ID"
        }
      ],
      "description": "The articles in one collection. Requires a collection id. Carries the name, status, the public url, view and popularity counts, and the created and updated times. Filter by status, which defaults to all -- so drafts are included alongside published articles unless excluded."
    },
    {
      "name": "Category Articles",
      "paged": true,
      "suffix": "/v1/categories/{Category ID}/articles?status={Status?:all|published|notpublished}",
      "responseSchema": {
        "articles": {
          "page": "double",
          "pages": "double",
          "count": "double",
          "items": [
            {
              "id": "string",
              "number": "double",
              "collectionId": "string",
              "slug": "string",
              "status": "string",
              "hasDraft": "boolean",
              "name": "string",
              "publicUrl": "string",
              "popularity": "double",
              "viewCount": "double",
              "createdBy": "double",
              "updatedBy": "double",
              "createdAt": "timeInstant",
              "updatedAt": "timeInstant",
              "lastPublishedAt": "timeInstant"
            }
          ]
        }
      },
      "lookups": [
        {
          "endpoint": "Article",
          "jsonPath": "$.articles.items[*]",
          "key": "id",
          "parameterName": "Article ID or Number"
        },
        {
          "endpoints": [
            "Related Articles",
            "Revisions"
          ],
          "jsonPath": "$.articles.items[*]",
          "key": "id",
          "parameterName": "Article ID"
        }
      ],
      "description": "The articles in one category. Requires a category id. The narrower slice."
    },
    {
      "name": "Article Search",
      "paged": true,
      "suffix": "/v1/search/articles?query={Query}&collectionId={Collection ID?}&siteId={Site ID?}&status={Status?:all|published|notpublished}&visibility={Visibility?:all|public|private}",
      "responseSchema": {
        "articles": {
          "page": "double",
          "pages": "double",
          "count": "double",
          "items": [
            {
              "id": "string",
              "collectionId": "string",
              "categoryIds": [
                "string"
              ],
              "slug": "string",
              "name": "string",
              "preview": "string",
              "url": "string",
              "docsUrl": "string",
              "number": "double",
              "status": "string",
              "visibility": "string"
            }
          ]
        }
      },
      "description": "Articles matching a search term, optionally within one collection or site. Full-text across titles and bodies."
    },
    {
      "name": "Related Articles",
      "paged": true,
      "suffix": "/v1/articles/{Article ID}/related?status={Status?:all|published|notpublished}",
      "responseSchema": {
        "articles": {
          "page": "double",
          "pages": "double",
          "count": "double",
          "items": [
            {
              "id": "string",
              "number": "double",
              "collectionId": "string",
              "slug": "string",
              "status": "string",
              "hasDraft": "boolean",
              "name": "string",
              "publicUrl": "string",
              "popularity": "double",
              "viewCount": "double",
              "createdBy": "double",
              "updatedBy": "double",
              "createdAt": "timeInstant",
              "updatedAt": "timeInstant",
              "lastPublishedAt": "timeInstant"
            }
          ]
        }
      },
      "lookups": [
        {
          "endpoint": "Article",
          "jsonPath": "$.articles.items[*]",
          "key": "id",
          "parameterName": "Article ID or Number"
        },
        {
          "endpoints": [
            "Related Articles",
            "Revisions"
          ],
          "jsonPath": "$.articles.items[*]",
          "key": "id",
          "parameterName": "Article ID"
        }
      ],
      "description": "The articles Help Scout considers related to one article. Requires an article id. Derived rather than authored, so it reflects text similarity rather than any editorial decision."
    },
    {
      "name": "Revisions",
      "paged": true,
      "suffix": "/v1/articles/{Article ID}/revisions",
      "responseSchema": {
        "revisions": {
          "page": "double",
          "pages": "double",
          "count": "double",
          "items": [
            {
              "id": "string",
              "articleId": "string",
              "createdBy": {
                "id": "double",
                "firstName": "string",
                "lastName": "string"
              },
              "createdAt": "timeInstant"
            }
          ]
        }
      },
      "description": "The edit history of one article, each revision with its author and timestamp. Requires an article id. The article carries only its current text, so this is the only record of when documentation changed and who changed it."
    },
    {
      "name": "Article",
      "paged": false,
      "suffix": "/v1/articles/{Article ID or Number}?draft={Draft: false|true}",
      "responseSchema": {
        "article": {
          "id": "string",
          "number": "double",
          "collectionId": "string",
          "slug": "string",
          "status": "string",
          "hasDraft": "boolean",
          "name": "string",
          "text": "string",
          "categories": [
            "string"
          ],
          "related": [
            "string"
          ],
          "publicUrl": "string",
          "popularity": "double",
          "keywords": [
            "string"
          ],
          "viewCount": "double",
          "createdBy": "double",
          "updatedBy": "double",
          "createdAt": "timeInstant",
          "updatedAt": "timeInstant",
          "lastPublishedAt": "timeInstant"
        }
      },
      "description": "One article by id or number, with its full text. The draft parameter returns the unpublished version where one exists, which is how a pending rewrite is seen."
    },
    {
      "name": "Revision",
      "paged": false,
      "suffix": "/v1/revisions/{Revision ID}",
      "responseSchema": {
        "revision": {
          "id": "string",
