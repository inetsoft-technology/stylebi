        "campaign_id": "string",
        "created_at": "timeInstant",
        "current_status": "string",
        "name": "string",
        "type": "string",
        "type_code": "double",
        "updated_at": "timeInstant"
      },
      "lookups": [
        {
          "endpoints": [
            "Email Campaign Activity",
            "Email Links",
            "Email Bounces",
            "Email Clicks",
            "Email Did Not Opens",
            "Email Forwards",
            "Email Opens",
            "Email Opt-outs",
            "Email Sends",
            "Email Unique Opens",
            "Email Campaign Activity Schedule",
            "Email Campaign Activity Send History"
          ],
          "jsonPath": "$.campaign_activities[*]",
