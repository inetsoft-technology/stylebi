        "reply_to_email": "string",
        "subject": "string",
        "html_content": "string",
        "permalink_url": "string",
        "preheader": "string",
        "physical_address_in_footer": {
          "address_line1": "string",
          "address_line2": "string",
          "address_line3": "string",
          "address_optional": "string",
          "city": "string",
          "country_code": "string",
          "country_name": "string",
          "organization_name": "string",
          "postal_code": "string",
          "state_code": "string",
          "state_name": "string",
          "state_non_us_name": "string"
        },
        "document_id": "string",
        "external_source_type": "string",
        "external_source_url": "string",
        "document_properties": {
          "style_content": "string",
          "letter_format": "string",
          "greeting_salutation": "string",
          "greeting_name_type": "string",
          "greeting_secondary": "string",
          "subscribe_link_enabled": "string",
          "subscribe_link_name": "string",
          "text_content": "string",
          "permission_reminder_enabled": "string",
          "permission_reminder": "string",
          "view_as_webpage_enabled": "string",
          "view_as_webpage_text": "string",
          "view_as_webpage_link_name": "string",
          "forward_email_link_enabled": "string",
          "forward_email_link_name": "string"
        }
      },
      "description": "One send of one campaign, with its subject, from address, preheader, the lists targeted and the physical address block. Requires an activity id. This is the level everything measurable hangs off."
    },
    {
      "name": "Email Campaign",
      "paged": false,
      "suffix": "/v3/emails/{Campaign ID}",
      "responseSchema": {
        "campaign_activities": [
          {
            "campaign_activity_id": "string",
            "role": "string",
            "document_id": "string"
          }
