# Surefire includes for core test shard 2 of pr-build.yml. Shard 2 runs only the
# inetsoft.sree and inetsoft.util packages, which shard 1 excludes, so every class runs in
# exactly one shard and a new package is picked up by shard 1. An includes file replaces
# the default includes, so the default test class name patterns are repeated per package.
inetsoft/sree/**/Test*
inetsoft/sree/**/*Test
inetsoft/sree/**/*Tests
inetsoft/sree/**/*TestCase
inetsoft/util/**/Test*
inetsoft/util/**/*Test
inetsoft/util/**/*Tests
inetsoft/util/**/*TestCase
